# --- panel (one NAS row: IP = NAS_IP, type other, this secret) ---
RADIUS_SERVER=PANEL_IP
RADIUS_SECRET=LONG_RANDOM_SECRET_SAME_AS_NAS_ROW
NAS_IP=SERVER_PUBLIC_IP

# --- SOCKS5 (port 1080 tcp+udp) ---
SOCKS_ENABLED=1
NAS_IDENTIFIER=socks
# HTTP / HTTPS proxy on the same port, same accounts (no UDP):
# HTTP_ENABLED=1
# HTTPS_ENABLED=1     # uses this image's certificate (OCSERV_HOST + ACME_EMAIL below)

# --- ocserv (port 443 tcp+udp, 80 for the certificate) ---
OCSERV_ENABLED=1
OCSERV_NAS_ID=ocserv
OCSERV_POOL=10.20.0.0/16
OCSERV_HOST=oc.example.com
ACME_EMAIL=you@example.com
# OCSERV_PORT=443
# OCSERV_DNS=1.1.1.1 8.8.8.8
# OCSERV_MTU=1400
# OCSERV_COOKIE_TIMEOUT=300
# One line per extra location (needs its own routing on the server):
# OCSERV_VHOST_NL=nl-oc.example.com=10.21.0.0/16
# Locations on the same host name (AnyConnect Group menu), each out of its own
# tunnel interface set up on this server (4th field; omit = default exit):
# OCSERV_LOCATIONS=uk:UK:10.21.0.0/16:wg-uk;de:Germany:10.22.0.0/16:wg-de
# Layer-2 tunnel (L2TP-ether, EoIP, VXLAN): interface@far-end-address, e.g.
# OCSERV_LOCATIONS=fi:Finland:10.21.0.0/16:l2tp-fi@172.31.98.2
# OCSERV_DEFAULT_NAME=Iran      # or none: no entry without a location
